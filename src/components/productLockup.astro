---
// A product's signature, sized as one unit.
//
// Lattice products render the rosette, then `lattice` in DM Sans Medium, then the product
// word in the accent. Per BRAND.md §1 the word `lattice` is always ink or paper and only
// the product word takes color.
//
// ArenaSwap uses its own wordmark SVG, shipped from its repo. It is never redrawn or
// re-typeset here. Two files rather than a CSS filter, because the orange period has to
// survive the theme swap.
import Rosette, { PRODUCT_ROTATIONS } from './rosette';
import { withBase } from '../lib/base';
import type { Product } from '../lib/products';

interface Props {
	wordmark: Product['wordmark'];
	fontSize?: string;
	class?: string;
}

const { wordmark, fontSize = '1.25rem', class: className } = Astro.props;

// The art is 1790x471 and stacks "arena" over "swap", so a line of it is only about a
// third of the file's height. The multiplier is what puts its letterforms at the same
// optical size as the Lattice wordmarks beside it, and it matches how ArenaSwap's own
// nav sizes the mark against its nav links.
const arenaHeight = `calc(${fontSize} * 1.9)`;
---

{
	wordmark.kind === 'lattice' ? (
		<span class:list={['d-inline-flex align-items-center gap-2', className]}>
			<Rosette
				size={`calc(${fontSize} * 1.5)`}
				count={PRODUCT_ROTATIONS}
				animate={false}
				title="Lattice"
			/>
			<span class="product-wordmark" style={`font-size: ${fontSize};`}>
				lattice <span class="wordmark-product">{wordmark.product}</span>
			</span>
		</span>
	) : (
		<span class:list={['d-inline-flex align-items-center', className]}>
			<img
				class="arena-mark arena-mark-light"
				src={withBase('/brand/arenaswap/wordmark-black.svg')}
				alt="ArenaSwap"
				style={`height: ${arenaHeight};`}
				width="1790"
				height="471"
			/>
			<img
				class="arena-mark arena-mark-dark"
				src={withBase('/brand/arenaswap/wordmark-white.svg')}
				alt=""
				aria-hidden="true"
				style={`height: ${arenaHeight};`}
				width="1790"
				height="471"
			/>
		</span>
	)
}

<style is:global>
	.arena-mark {
		width: auto;
		display: block;
	}

	.arena-mark-dark {
		display: none;
	}

	[data-bs-theme='dark'] {
		.arena-mark-light {
			display: none;
		}
		.arena-mark-dark {
			display: block;
		}
	}
</style>
