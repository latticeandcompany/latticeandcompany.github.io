---
// The shared top of a product page: lockup, title, lead. Every product page opens the
// same way so the three read as one set, which is the only reason they're worth having.
import ProductLockup from './productLockup.astro';
import type { Product } from '../lib/products';

interface Props {
	product: Product;
	title: string;
	/** The one-line description under the title. */
	lead: string;
	/**
	 * Trailing run of the title that takes the accent. Set for ArenaSwap, whose own hero
	 * colors the period in `Never miss the moment.` — mirrored here rather than invented.
	 */
	accentTail?: string;
	/**
	 * Set the title in DM Sans instead of the parent's serif. ArenaSwap's own headline
	 * face is DM Sans Bold with tight tracking, and its page should look like its brand,
	 * not like the holding company's.
	 */
	sans?: boolean;
}

const { product, title, lead, accentTail, sans = false } = Astro.props;
const head = accentTail && title.endsWith(accentTail) ? title.slice(0, -accentTail.length) : title;
---

<header class="pb-5">
	<ProductLockup wordmark={product.wordmark} fontSize="1.75rem" class="mb-4" />
	<h1 class:list={['page-title mb-3', sans && 'page-title-sans']}>
		{head}{accentTail && <span class="title-accent">{accentTail}</span>}
	</h1>
	<p class="page-lead mb-0">{lead}</p>
</header>

<style>
	.page-title {
		font-family: 'DM Serif Text', Georgia, serif;
		font-weight: 400;
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.12;
		letter-spacing: -0.015em;
		max-width: 24ch;
	}

	.page-title-sans {
		font-family: 'DM Sans', system-ui, sans-serif;
		font-weight: 700;
		font-size: clamp(2.25rem, 5.5vw, 3.5rem);
		line-height: 1.04;
		letter-spacing: -0.04em;
	}

	.title-accent {
		color: var(--accent);
	}

	.page-lead {
		max-width: 40rem;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--text-muted);
	}
</style>
