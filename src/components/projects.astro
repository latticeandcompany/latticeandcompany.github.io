---
import ProductRow from './productRow.astro';
import { products } from '../lib/products';
---

<section id="projects" class="px-3 py-5">
	<div class="mx-auto" style="max-width: 72rem;">
		<h2 class="section-title mb-4">Projects</h2>
		{products.map((p) => <ProductRow product={p} />)}
	</div>
</section>
