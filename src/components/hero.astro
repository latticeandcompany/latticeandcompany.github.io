---
import Weave from './weave.astro';

// Played once on load, in order, then the headline rests on the last.
const audiences = ['developers', 'teams', 'sports fans'];
const landing = 'everyone';
---

<section class="hero">
	<Weave />
	<div class="hero-text">
		<h1 class="hero-title">
			Lattice &amp; Company makes <span class="text-nowrap">open-source</span> tools for
			<span class="rotator" aria-hidden="true">
				{audiences.map((word, i) => <span style={`--i: ${i};`}>{word}.</span>)}
				<span class="rotator-landing" style={`--i: ${audiences.length};`}>{landing}.</span>
			</span>
			<span class="visually-hidden">{landing}.</span>
		</h1>
	</div>
</section>
