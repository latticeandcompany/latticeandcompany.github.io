---
import Layout from '../layouts/Layout.astro';
import ProductHeader from '../components/productHeader.astro';
import { productById } from '../lib/products';

// MESSAGING.md reserves the name "Lattice Build" for contexts where it sits beside other
// Lattice products. This whole site is one, so the name is licensed here — and only here.
const product = productById('build');

const points = [
	'Builds and tests every project in the repo from one command, in the right order, in parallel.',
	'Skips anything whose inputs have not changed. The result comes back out of the cache instead.',
	'Works out how each project builds from what is already in its directory. Override any command in lattice.json.',
	'Pins the version of node, rust, go or whatever else a project needs, and provisions it if it is missing.',
	'A folder that already has its own task runner drops in as a single workspace.',
];

const sample = `{
  "workspaces": ["apps/api", "apps/web", "libs/core"],
  "engines": { "node": "22.x", "rust": "1.83" },
  "pipeline": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "test": { "dependsOn": ["build"] }
  }
}`;
---

<Layout
	title="Lattice Build · Lattice & Company"
	description="A high-performance, local toolchain for managing monorepos."
>
	<div class:list={['px-3 py-5', product.accentClass]}>
		<div class="mx-auto" style="max-width: 48rem;">
			<ProductHeader product={product} title="Lattice Build" lead={product.heading} />

			<p class="page-body">
				A repo with a Go service, a React app and a Python worker in it usually means three
				different build commands and three different ways of getting them wrong. Lattice runs
				all of it, in dependency order, off one file.
			</p>
			<p class="page-body">
				It hashes what went into each task: the command, the files, the environment, the
				lockfiles. When nothing has moved, the old result comes back instead. Change one file
				and only what depends on it runs again.
			</p>

			<ul class="page-list">
				{points.map((p) => <li>{p}</li>)}
			</ul>

			<pre class="code-sample"><code>{sample}</code></pre>

			<div class="d-flex flex-wrap align-items-center gap-4">
				<a
					href="https://latticeandcompany.github.io/lattice/"
					target="_blank"
					rel="noopener noreferrer"
					class="link-accent"
				>
					Docs and install <span aria-hidden="true">&#8599;</span>
				</a>
				<a
					href="https://github.com/latticeandcompany/lattice"
					target="_blank"
					rel="noopener noreferrer"
					class="link-quiet"
				>
					GitHub <span aria-hidden="true">&#8599;</span>
				</a>
			</div>
		</div>
	</div>
</Layout>
