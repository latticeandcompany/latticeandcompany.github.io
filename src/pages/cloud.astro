---
import Layout from '../layouts/Layout.astro';
import ProductHeader from '../components/productHeader.astro';
import { productById } from '../lib/products';

const product = productById('cloud');

const points = [
	'A build someone already ran is a build nobody else has to.',
	'CI stops rebuilding from scratch on every run.',
	'A fresh clone starts warm instead of cold.',
];
---

<Layout title="Lattice Cloud · Lattice & Company" description="A shared cache for Lattice builds.">
	<div class:list={['px-3 py-5', product.accentClass]}>
		<div class="mx-auto" style="max-width: 48rem;">
			<ProductHeader product={product} title="Lattice Cloud" lead={product.heading} />

			<p class="page-body">
				Lattice already skips work it has done before, but only on the machine that did it. Six
				people on a team means the same build happens six times, and CI makes it seven.
			</p>
			<p class="page-body">
				Cloud puts that cache somewhere everyone can reach. Same keys, same rules, one shared
				place to look before anything gets rebuilt.
			</p>

			<ul class="page-list">
				{points.map((p) => <li>{p}</li>)}
			</ul>

			{/*
				Deliberately blunt. There is no waitlist to join and no date to give, and dressing
				that up as anticipation would be worse than saying it plainly.
			*/}
			<div class="status-block mb-4">
				<p class="mb-0" style="color: var(--text-subtle);">
					Still being built. Nothing to install yet, and no waitlist.
				</p>
			</div>

			<a
				href="https://github.com/latticeandcompany/lattice"
				target="_blank"
				rel="noopener noreferrer"
				class="link-quiet"
			>
				Follow the Lattice repository <span aria-hidden="true">&#8599;</span>
			</a>
		</div>
	</div>
</Layout>

<style>
	.status-block {
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 1.25rem 1.5rem;
		max-width: 40rem;
	}
</style>
