---
import Layout from '../layouts/Layout.astro';
import { orgUrl } from '../lib/nav';
import { withBase } from '../lib/base';
---

<Layout title="Not found · Lattice & Company" description="That page does not exist.">
	<section class="px-3 py-5">
		<div class="mx-auto" style="max-width: 48rem; padding-block: clamp(3rem, 8vw, 6rem);">
			<p class="meta-line mb-3">404</p>
			<h1 class="display-serif mb-3" style="font-size: clamp(2rem, 5vw, 3rem);">Page not found</h1>
			<p class="mb-4" style="color: var(--text-subtle); font-size: 1.0625rem;">
				Check the URL, or go back to the projects.
			</p>
			<div class="d-flex flex-wrap gap-2">
				<a href={withBase('/')} class="btn btn-contrast px-4">Back home</a>
				<a
					href={orgUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline-quiet px-4"
				>
					<i class="bi bi-github me-2" aria-hidden="true"></i>GitHub
				</a>
			</div>
		</div>
	</section>
</Layout>
